# Credentials for scripts/run-main-runtime.sh
#
# Install:
#   cp scripts/shellbeam-tunnel.env.example ~/.shellbeam-tunnel.env
#   chmod 600 ~/.shellbeam-tunnel.env
#   # then fill in the two values below
#
# run-main-runtime.sh refuses to start unless this file is mode 600, because a
# credential file readable by group or other is a leak. Keep it outside the
# repository -- never commit a filled-in copy.
#
# Read by tunnel-client from the environment, so the key never appears on a
# command line or in `ps` output.

# Runtime API key from https://platform.openai.com/settings/organization/api-keys
# Use a Runtime key, not the admin key.
CONTROL_PLANE_API_KEY=

# Optional. From https://platform.openai.com/settings/organization/tunnels
# When set, run-main-runtime.sh asserts that this matches control_plane.tunnel_id
# in ~/.config/tunnel-client/shellbeam.yaml. That catches pointing at a tunnel
# already bound to a different local MCP server, which otherwise shows up only as
# channel=main contention.
SHELLBEAM_TUNNEL_ID=
