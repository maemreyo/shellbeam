  "invariants": [
    {
      "invariant": 1,
      "text": "Canonical Decision Protocol truth is append-only; lifecycle is projected.",
      "tasks": [
        1,
        2,
        3,
        4,
        6,
        9,
        10
      ]
    },
    {
      "invariant": 2,
      "text": "New governed episodes bind the server-resolved current effective applicable policy activation; callers cannot select historical weaker activations.",
      "tasks": [
        2,
        3
      ]
    },
    {
      "invariant": 3,
      "text": "Episode policy snapshot/activation is durably bound and immutable for episode lifetime.",
      "tasks": [
        2,
        3
      ]
    },
    {
      "invariant": 4,
      "text": "Candidate revision is immutable replacement with active-parent CAS.",
      "tasks": [
        3
      ]
    },
    {
      "invariant": 5,
      "text": "Candidate revision does not implicitly inherit predictions.",
      "tasks": [
        3,
        4
      ]
    },
    {
      "invariant": 6,
      "text": "Prediction declaration happens-before experiment observability.",
      "tasks": [
        4
      ]
    },
    {
      "invariant": 7,
      "text": "Experiment definition/seal/close never schedules execution.",
      "tasks": [
        4
      ]
    },
    {
      "invariant": 8,
      "text": "V1 permits at most one observation-producing execution link per experiment.",
      "tasks": [
        5
      ]
    },
    {
      "invariant": 9,
      "text": "Experiment identity is part of immutable operation replay/observation identity; omitted/changed bindings conflict on the same `operation_id`.",
      "tasks": [
        5
      ]
    },
    {
      "invariant": 10,
      "text": "Successful experiment-linked admission and durable `ExperimentExecutionLink` are recovery-indivisible before spawn.",
      "tasks": [
        5
      ]
    },
    {
      "invariant": 11,
      "text": "Protocol observation truth is server-derived, complete for the linked observation domain, and non-cherry-pickable.",
      "tasks": [
        6
      ]
    },
    {
      "invariant": 12,
      "text": "At most one canonical `ExperimentObservationBinding` exists per experiment; same semantic cut replays, different cut conflicts.",
      "tasks": [
        6
      ]
    },
    {
      "invariant": 13,
      "text": "Every linked execution must have a terminal observation binding before selection commit, including post-link aborted experiments.",
      "tasks": [
        6,
        9
      ]
    },
    {
      "invariant": 14,
      "text": "Verification-result observation sets are attributable to the linked operation and frozen derivation cut, not arbitrary workspace history.",
      "tasks": [
        6
      ]
    },
    {
      "invariant": 15,
      "text": "ShellBeam evaluates typed declared expectations, never semantic hypothesis truth.",
      "tasks": [
        6
      ]
    },
    {
      "invariant": 16,
      "text": "V1 predicate kinds are closed and versioned; there is no generic expression DSL.",
      "tasks": [
        1,
        4,
        6
      ]
    },
    {
      "invariant": 17,
      "text": "REQUIRED mismatch is an implicit candidate-contract blocker only when determinately evaluated.",
      "tasks": [
        7
      ]
    },
    {
      "invariant": 18,
      "text": "Unevaluated or indeterminate REQUIRED prediction does not silently become a blocker.",
      "tasks": [
        7
      ]
    },
    {
      "invariant": 19,
      "text": "Candidate-scoped policy evaluation uses four bounded V1 requirement kinds: challenge, prediction evaluation, discrimination, verifier assessment.",
      "tasks": [
        7
      ]
    },
    {
      "invariant": 20,
      "text": "Caller-declared verifier context has no hard-gate authority; exact required context matches only server/provider-qualified context materialized into the assessment.",
      "tasks": [
        8
      ]
    },
    {
      "invariant": 21,
      "text": "Discrimination qualification is frozen at seal time against then-eligible candidate lineages.",
      "tasks": [
        4,
        7
      ]
    },
    {
      "invariant": 22,
      "text": "Realized discrimination is experiment-local against an authoritative canonical-ledger replay cut and excludes its own aggregate requirement/gate status.",
      "tasks": [
        4,
        6,
        7
      ]
    },
    {
      "invariant": 23,
      "text": "Verification predicates evaluate the complete compatible qualified attributable evidence set, not a favorable individual record.",
      "tasks": [
        6
      ]
    },
    {
      "invariant": 24,
      "text": "Protocol fold is deterministic: BLOCKED > INDETERMINATE > CLEAR.",
      "tasks": [
        7
      ]
    },
    {
      "invariant": 25,
      "text": "Budget admission is a separate ceiling and never changes protocol satisfaction.",
      "tasks": [
        7
      ]
    },
    {
      "invariant": 26,
      "text": "Projection digest represents semantic epistemic/protocol state, including normalized verifier semantic state; audit digest represents exact history.",
      "tasks": [
        7,
        8
      ]
    },
    {
      "invariant": 27,
      "text": "`expected_projection_digest` is the semantic CAS token for selection commit.",
      "tasks": [
        9
      ]
    },
    {
      "invariant": 28,
      "text": "Source-generation mismatch fail-closes V1 selection and cannot be overridden.",
      "tasks": [
        3,
        9
      ]
    },
    {
      "invariant": 29,
      "text": "Selection proposal has no transition authority.",
      "tasks": [
        9
      ]
    },
    {
      "invariant": 30,
      "text": "Selection commit and close-unresolved share one atomic episode-terminal boundary.",
      "tasks": [
        9
      ]
    },
    {
      "invariant": 31,
      "text": "Selection commit persists durable idempotency key + semantic intent fingerprint transactionally with terminalization.",
      "tasks": [
        9
      ]
    },
    {
      "invariant": 32,
      "text": "Normal and override commits are epistemically distinct even for the same candidate.",
      "tasks": [
        9,
        10
      ]
    },
    {
      "invariant": 33,
      "text": "Override never rewrites blockers as satisfied.",
      "tasks": [
        10
      ]
    },
    {
      "invariant": 34,
      "text": "`OverridePolicy.allowed=true` requires an exact authority class; `allowed=false` forbids one.",
      "tasks": [
        1,
        10
      ]
    },
    {
      "invariant": 35,
      "text": "DecisionAuthorityAttestation is immutable capability proof with only trusted resolver/provider-backed canonical producers; current qualification is resolver-derived.",
      "tasks": [
        10
      ]
    },
    {
      "invariant": 36,
      "text": "V1 has no authority lattice, wildcard authority equivalence, or generic core revocation ledger.",
      "tasks": [
        10
      ]
    },
    {
      "invariant": 37,
      "text": "Decision Policy activation authority is `explicit_caller`; Decision Authority Attestation does not authorize policy activation in V1.",
      "tasks": [
        2,
        10
      ]
    },
    {
      "invariant": 38,
      "text": "Override authority is revalidated at terminal commit authorization time.",
      "tasks": [
        10
      ]
    },
    {
      "invariant": 39,
      "text": "Only `QUALIFIED` exact-class/exact-scope authority may authorize a new override commit.",
      "tasks": [
        10
      ]
    },
    {
      "invariant": 40,
      "text": "Override intent covers the exact current candidate/policy/projection/blocker set.",
      "tasks": [
        10
      ]
    },
    {
      "invariant": 41,
      "text": "SelectionCommit persists the exact override authorization cut used to authorize history.",
      "tasks": [
        10
      ]
    },
    {
      "invariant": 42,
      "text": "Later expiry/revocation does not rewrite a durable historical commit.",
      "tasks": [
        10,
        13
      ]
    },
    {
      "invariant": 43,
      "text": "Failed/non-durable commit retry must revalidate authority; replay of durable idempotent success does not.",
      "tasks": [
        9,
        10,
        13
      ]
    },
    {
      "invariant": 44,
      "text": "`VerifierAssessment` is a separate non-evidence ontology.",
      "tasks": [
        1,
        8
      ]
    },
    {
      "invariant": 45,
      "text": "Policy/projection exposes constraints and allowed protocol transitions, never recommended engineering next actions.",
      "tasks": [
        7,
        11,
        12
      ]
    },
    {
      "invariant": 46,
      "text": "Candidate committed does not imply implementation verified or task done.",
      "tasks": [
        12,
        13
      ]
    },
    {
      "invariant": 47,
      "text": "Oracle-gap metrics are unavailable unless candidate evaluation is genuinely exhaustive under a qualifying oracle.",
      "tasks": [
        13
      ]
    },
    {
      "invariant": 48,
      "text": "`CLOSED_UNRESOLVED` remains the truthful terminal escape from an unsatisfied or unresolvable protocol.",
      "tasks": [
        9,
        13
      ]
    }
  ],
