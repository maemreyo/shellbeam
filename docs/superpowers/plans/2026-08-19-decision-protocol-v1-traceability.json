    },
    {
      "task": 5,
      "title": "Bind experiments into immutable operation admission and replay identity"
    },
    {
      "task": 6,
      "title": "Materialize complete typed observations and close/abort experiments safely"
    },
    {
      "task": 7,
      "title": "Implement candidate-scoped policy evaluation, budget admission, and semantic projections"
    },
    {
      "task": 8,
      "title": "Add verifier assessments with a hard provenance firewall"
    },
    {
      "task": 9,
      "title": "Implement selection proposal, semantic CAS, durable idempotency, and close-unresolved"
    },
    {
      "task": 10,
