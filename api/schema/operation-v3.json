{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shellbeam.dev/schema/operation-v3.json",
  "title": "ShellBeam typed project operation reservation v3",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "project_parameter_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "kind": {
          "enum": [
            "string",
            "enum",
            "integer",
            "repo_path",
            "repo_package"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source": {
          "enum": [
            "caller",
            "default"
          ]
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "provider_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "kind",
        "value",
        "source"
      ]
    },
    "project_command_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_schema_version": {
          "const": 2
        },
        "command_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "parameter_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/project_parameter_binding"
          }
        },
        "resolved_argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "logical_cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "resolved_cwd": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "source_generation": {
          "type": "string",
          "pattern": "^gen_[0-9a-f]{64}$"
        },
        "path_observation_quality": {
          "enum": [
            "exact_at_bind"
          ]
        }
      },
      "required": [
        "schema_version",
        "manifest_digest",
        "manifest_schema_version",
        "command_id",
        "parameter_fingerprint",
        "parameters",
        "resolved_argv",
        "logical_cwd",
        "resolved_cwd"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": 3
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "request_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "execution_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "observation_binding_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "structured_adapter": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "execution_mode": {
      "const": "argv"
    },
    "executable": {
      "type": "string",
      "minLength": 1
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "items": {
        "type": "string"
      }
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "logical_cwd": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "tty": {
      "type": "boolean"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "shell": {
      "type": "string"
    },
    "daemon_incarnation": {
      "type": "string",
      "minLength": 1
    },
    "control_reservation_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "activity_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "project_command": {
      "$ref": "#/$defs/project_command_binding"
    },
    "environment_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^env_[0-9a-f]{64}$"
        },
        "environment_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment_fingerprint_version": {
          "const": 1
        },
        "toolchain_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolchain_fingerprint_version": {
          "const": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "snapshot_id",
        "environment_fingerprint",
        "environment_fingerprint_version",
        "captured_at"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "toolchain_fingerprint"
            ]
          },
          "then": {
            "required": [
              "toolchain_fingerprint_version"
            ]
          }
        },
        {
          "if": {
            "required": [
              "toolchain_fingerprint_version"
            ]
          },
          "then": {
            "required": [
              "toolchain_fingerprint"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "session_id",
    "request_fingerprint",
    "execution_fingerprint",
    "workspace_id",
    "logical_cwd",
    "execution_mode",
    "executable",
    "argv",
    "cwd",
    "tty",
    "timeout_ms",
    "daemon_incarnation",
    "control_reservation_bytes",
    "project_command",
    "created_at"
  ],
  "allOf": [
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "command"
            ]
          }
        ]
      }
    }
  ]
}
