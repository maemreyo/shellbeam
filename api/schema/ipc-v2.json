{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shellbeam.dev/schema/ipc-v2.json",
  "title": "ShellBeam IPC v2",
  "type": "object",
  "unevaluatedProperties": false,
  "oneOf": [
    {"$ref": "#/$defs/start_request"},
    {"$ref": "#/$defs/poll_request"},
    {"$ref": "#/$defs/write_request"},
    {"$ref": "#/$defs/kill_request"},
    {"$ref": "#/$defs/inspect_server_request"},
    {"$ref": "#/$defs/inspect_workspace_request"},
    {"$ref": "#/$defs/inspect_activity_request"},
    {"$ref": "#/$defs/inspect_project_request"},
    {"$ref": "#/$defs/start_poll_success_response"},
    {"$ref": "#/$defs/write_kill_success_response"},
    {"$ref": "#/$defs/inspect_server_success_response"},
    {"$ref": "#/$defs/inspect_workspace_success_response"},
    {"$ref": "#/$defs/inspect_activity_success_response"},
    {"$ref": "#/$defs/inspect_project_success_response"},
    {"$ref": "#/$defs/error_response"}
  ],
  "$defs": {
    "start_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipc_version": {"const": 2},
        "kind": {"const": "request"},
        "request_id": {"type": "string"},
        "action": {"const": "start"},
        "operation_id": {"type": "string"},
        "workspace_id": {"type": "string", "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"},
        "activity_id": {"type": "string", "minLength": 1, "maxLength": 128, "allOf": [{"not": {"pattern": "/"}}, {"not": {"pattern": "\\\\"}}]},
        "workspace_hint": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "workspace_id": {"type": "string", "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"},
            "branch": {"type": "string", "maxLength": 128},
            "git_profile": {"type": "string", "maxLength": 128}
          }
        },
        "command": {"type": "string"},
        "argv": {"type": "array", "minItems": 1, "prefixItems": [{"type": "string", "minLength": 1}], "items": {"type": "string"}},
        "intent": {"type": "object", "additionalProperties": false, "properties": {"kind": {"enum": ["inspect", "format", "edit", "test", "build", "generate", "git-push", "release", "long-running", "other"]}, "mutates_source": {"oneOf": [{"type": "boolean"}, {"type": "null"}]}, "external_effect": {"oneOf": [{"type": "boolean"}, {"type": "null"}]}}, "required": ["kind"]},
        "cwd": {"type": "string"},
        "tty": {"type": "boolean"},
        "timeout_ms": {"type": "integer", "minimum": 0},
        "yield_time_ms": {"type": "integer", "minimum": 0},
        "max_output_bytes": {"type": "integer", "minimum": 1}
      },
      "required": ["ipc_version", "kind", "request_id", "action", "operation_id"],
      "allOf": [
        {"oneOf": [
        {"required": ["workspace_id"], "not": {"properties": {"cwd": {"pattern": "^/"}}, "required": ["cwd"]}},
        {"required": ["cwd"], "properties": {"cwd": {"pattern": "^/"}}, "not": {"required": ["workspace_id"]}}
        ]},
        {"oneOf": [
          {"required": ["command"], "not": {"required": ["argv"]}},
          {"required": ["argv"], "not": {"required": ["command"]}}
        ]}
      ]
    },
    "poll_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipc_version": {"const": 2},
        "kind": {"const": "request"},
        "request_id": {"type": "string"},
        "action": {"const": "poll"},
        "session_id": {"type": "string"},
        "cursor": {"type": "integer", "minimum": 0},
        "yield_time_ms": {"type": "integer", "minimum": 0},
        "max_output_bytes": {"type": "integer", "minimum": 1}
      },
      "required": ["ipc_version", "kind", "request_id", "action", "session_id"]
    },
    "write_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipc_version": {"const": 2},
        "kind": {"const": "request"},
        "request_id": {"type": "string"},
        "action": {"const": "write"},
        "session_id": {"type": "string"},
        "input_offset": {"type": "integer", "minimum": 0},
        "chars": {"type": "string"},
        "eof": {"const": true}
      },
      "required": ["ipc_version", "kind", "request_id", "action", "session_id", "input_offset"],
      "oneOf": [{"required": ["chars"], "not": {"required": ["eof"]}}, {"required": ["eof"], "not": {"required": ["chars"]}}]
    },
    "kill_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipc_version": {"const": 2},
        "kind": {"const": "request"},
        "request_id": {"type": "string"},
        "action": {"const": "kill"},
        "session_id": {"type": "string"},
        "kill_id": {"type": "string"},
        "signal": {"enum": ["INT", "TERM", "KILL"]}
      },
      "required": ["ipc_version", "kind", "request_id", "action", "session_id", "kill_id"]
    },
    "inspect_server_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"ipc_version": {"const": 2}, "kind": {"const": "request"}, "request_id": {"type": "string"}, "action": {"const": "inspect.server"}},
      "required": ["ipc_version", "kind", "request_id", "action"]
    },
    "inspect_workspace_request":{"type":"object","additionalProperties":false,"properties":{"ipc_version":{"const":2},"kind":{"const":"request"},"request_id":{"type":"string"},"action":{"const":"inspect.workspace"},"workspace_id":{"type":"string","pattern":"^ws_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["ipc_version","kind","request_id","action","workspace_id"]},
    "inspect_activity_request":{"type":"object","additionalProperties":false,"properties":{"ipc_version":{"const":2},"kind":{"const":"request"},"request_id":{"type":"string"},"action":{"const":"inspect.activity"},"activity_id":{"type":"string","minLength":1,"maxLength":128}},"required":["ipc_version","kind","request_id","action","activity_id"]},
    "inspect_project_request":{"type":"object","additionalProperties":false,"properties":{"ipc_version":{"const":2},"kind":{"const":"request"},"request_id":{"type":"string"},"action":{"const":"inspect.project"},"workspace_id":{"type":"string","pattern":"^ws_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["ipc_version","kind","request_id","action","workspace_id"]},
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {"type": "string"},
        "activity_id": {"type": "string"},
        "workspace_id": {"type": "string"},
        "session_id": {"type": "string"},
        "state": {"enum": ["starting", "running", "finalizing", "completed", "failed", "timed_out", "killed", "abandoned", ""]},
        "outcome": {"enum": ["", "success", "failure", "timeout", "killed", "ambiguous"]},
        "output": {"type": "string"},
        "cursor": {"type": "integer", "minimum": 0},
        "next_cursor": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "accepted_input_bytes": {"type": "integer", "minimum": 0},
        "next_input_offset": {"type": "integer", "minimum": 0},
        "eof_queued": {"type": "boolean"},
        "kill_id": {"type": "string"},
        "signal": {"type": "string"},
        "signal_attempt": {"$ref": "#/$defs/signal_evidence"},
        "receipt": {"oneOf": [{"$ref": "#/$defs/receipt_v1"}, {"$ref": "#/$defs/receipt_v2"}]}
      },
      "required": ["session_id", "state", "outcome", "cursor", "next_cursor", "truncated", "signal_attempt"]
    },
    "availability": {"enum": ["available", "unavailable"]},
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shellbeam_protocol_version": {"type": "integer", "minimum": 1},
        "receipt_schema_versions": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
        "project_manifest_schema_versions": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
        "features": {"type": "object", "additionalProperties": {"$ref": "#/$defs/availability"}},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command_bytes": {"type": "integer", "minimum": 0},
            "response_bytes": {"type": "integer", "minimum": 0},
            "session_output_bytes": {"type": "integer", "minimum": 0},
            "runtime_ms": {"type": "integer", "minimum": 0},
            "live_sessions": {"type": "integer", "minimum": 0},
            "activity_history": {"type": "integer", "minimum": 0}
          },
          "required": ["command_bytes", "response_bytes", "session_output_bytes", "runtime_ms", "live_sessions", "activity_history"]
        }
      },
      "required": ["shellbeam_protocol_version", "receipt_schema_versions", "project_manifest_schema_versions", "features", "limits"]
    },
    "workspace": {"type":"object","additionalProperties":false,"properties":{"schema_version":{"const":1},"workspace_id":{"type":"string","pattern":"^ws_[0-9A-HJKMNP-TV-Z]{26}$"},"repository_id":{"type":"string","pattern":"^repo_[0-9A-HJKMNP-TV-Z]{26}$"},"label":{"type":"string","minLength":1,"maxLength":128},"root":{"type":"string","pattern":"^/"},"git_dir":{"type":"string","pattern":"^/"},"branch":{"type":"string","maxLength":1024},"created_at":{"type":"string","format":"date-time"},"last_seen_at":{"type":"string","format":"date-time"}},"required":["schema_version","workspace_id","repository_id","label","root","git_dir","created_at","last_seen_at"]},
    "activity_path_fact": {"type":"object","additionalProperties":false,"properties":{"path":{"type":"string","minLength":1,"maxLength":1024},"state":{"enum":["modified","added","deleted","renamed","unmerged","untracked"]},"original_path":{"type":"string","maxLength":1024}},"required":["path","state"]},
    "activity_baseline": {"type":"object","additionalProperties":false,"properties":{"schema_version":{"const":1},"workspace_id":{"type":"string","pattern":"^ws_[0-9A-HJKMNP-TV-Z]{26}$"},"ref":{"type":"string","maxLength":1024},"head":{"type":"string","maxLength":128},"quality":{"enum":["fresh","cached","stale","unavailable"]},"observed_at":{"type":"string","format":"date-time"},"paths":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/activity_path_fact"}},"paths_truncated":{"type":"boolean"}},"required":["schema_version","workspace_id","quality","observed_at","paths_truncated"]},
    "activity_operation_ref": {"type":"object","additionalProperties":false,"properties":{"operation_id":{"type":"string","minLength":1,"maxLength":128},"session_id":{"type":"string","minLength":1},"workspace_id":{"type":"string","pattern":"^ws_[0-9A-HJKMNP-TV-Z]{26}$"},"observed_at":{"type":"string","format":"date-time"}},"required":["operation_id","session_id","observed_at"]},
    "activity": {"type":"object","additionalProperties":false,"properties":{"schema_version":{"const":1},"activity_id":{"type":"string","minLength":1,"maxLength":128,"allOf":[{"not":{"pattern":"/"}},{"not":{"pattern":"\\\\"}}]},"label":{"type":"string","maxLength":128},"workspace_ids":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","pattern":"^ws_[0-9A-HJKMNP-TV-Z]{26}$"}},"operations":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/activity_operation_ref"}},"baselines":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/activity_baseline"}},"compacted_operations":{"type":"integer","minimum":0},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"required":["schema_version","activity_id","compacted_operations","created_at","updated_at"]},
    "project_manifest": {"type":"object","additionalProperties":false,"properties":{"schema_version":{"const":1},"project":{"type":"object","additionalProperties":false,"properties":{"name":{"type":"string","maxLength":1024}}},"toolchains":{"type":"object","maxProperties":64,"propertyNames":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"additionalProperties":{"type":"object","additionalProperties":false,"properties":{"version":{"type":"string","maxLength":1024},"version_source":{"type":"string","minLength":1,"maxLength":1024,"allOf":[{"not":{"pattern":"^/"}},{"not":{"pattern":"^\\.\\./"}},{"not":{"pattern":"^\\.\\.$"}}]},"manager":{"type":"string","maxLength":1024}},"oneOf":[{"required":["version"],"not":{"anyOf":[{"required":["version_source"]},{"required":["manager"]}]}},{"required":["version_source"],"not":{"anyOf":[{"required":["version"]},{"required":["manager"]}]}},{"required":["manager"],"not":{"anyOf":[{"required":["version"]},{"required":["version_source"]}]}}]}},"commands":{"type":"object","maxProperties":64,"propertyNames":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"additionalProperties":{"type":"object","additionalProperties":false,"properties":{"argv":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"string","minLength":1,"maxLength":1024}},"shell":{"type":"string","minLength":1,"maxLength":1024},"cwd":{"type":"string","minLength":1,"maxLength":1024,"allOf":[{"not":{"pattern":"^/"}},{"not":{"pattern":"^\\.\\./"}},{"not":{"pattern":"^\\.\\.$"}}]},"kind":{"enum":["format","inspect","test","build","generate","release"]},"cost":{"enum":["fast","medium","expensive"]},"source_scope":{"enum":["none","affected","full"]},"mutates_source":{"type":"boolean"},"external_effect":{"type":"boolean"},"timeout_ms":{"type":"integer","minimum":0,"maximum":86400000},"expected_outputs":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"properties":{"path":{"type":"string","minLength":1,"maxLength":1024,"allOf":[{"not":{"pattern":"^/"}},{"not":{"pattern":"^\\.\\./"}},{"not":{"pattern":"^\\.\\.$"}}]},"kind":{"enum":["file","directory","symlink"]},"digest":{"enum":["none","sha256","tree-sha256"]},"role":{"type":"string","maxLength":1024},"required":{"type":"boolean"}},"required":["path","kind","required"]}},"depends_on":{"type":"array","maxItems":64,"items":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"}}},"required":["cwd"],"oneOf":[{"required":["argv"],"not":{"required":["shell"]}},{"required":["shell"],"not":{"required":["argv"]}}]}},"verification_profiles":{"type":"object","maxProperties":16,"propertyNames":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"additionalProperties":{"type":"object","additionalProperties":false,"properties":{"steps":{"type":"array","maxItems":64,"items":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"}}},"required":["steps"]}},"relevant_environment":{"type":"array","maxItems":64,"items":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]{0,127}$"}},"outputs":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"properties":{"path":{"type":"string","minLength":1,"maxLength":1024,"allOf":[{"not":{"pattern":"^/"}},{"not":{"pattern":"^\\.\\./"}},{"not":{"pattern":"^\\.\\.$"}}]},"kind":{"enum":["file","directory","symlink"]},"digest":{"enum":["none","sha256","tree-sha256"]},"role":{"type":"string","maxLength":1024},"required":{"type":"boolean"}},"required":["path","kind","required"]}}},"required":["schema_version"]},
    "project_inspection": {"type":"object","additionalProperties":false,"properties":{"status":{"enum":["absent","valid","invalid","review_due"]},"schema_version":{"type":"integer","minimum":1},"manifest_digest":{"type":"string","maxLength":128},"discovery_fingerprint":{"type":"string","maxLength":128},"review_fingerprint":{"type":"string","maxLength":128},"confidence":{"enum":["high","low","none"]},"provenance":{"const":"workspace_manifest"},"code":{"type":"string","maxLength":128},"manifest":{"$ref":"#/$defs/project_manifest"}},"required":["status","confidence","provenance"]},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"},
        "details": {"type": "object", "maxProperties": 8, "additionalProperties": {"type": "string", "maxLength": 256}}
      },
      "required": ["code", "message", "retryable"]
    },
    "inspect_server_success_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipc_version": {"const": 2},
        "kind": {"const": "response"},
        "request_id": {"type": "string"},
        "action": {"const": "inspect.server"},
        "ok": {"const": true},
        "server": {"$ref": "#/$defs/catalog"}
      },
      "required": ["ipc_version", "kind", "request_id", "action", "ok", "server"]
    },
    "inspect_workspace_success_response":{"type":"object","additionalProperties":false,"properties":{"ipc_version":{"const":2},"kind":{"const":"response"},"request_id":{"type":"string"},"action":{"const":"inspect.workspace"},"ok":{"const":true},"workspace":{"$ref":"#/$defs/workspace"}},"required":["ipc_version","kind","request_id","action","ok","workspace"]},
    "inspect_activity_success_response":{"type":"object","additionalProperties":false,"properties":{"ipc_version":{"const":2},"kind":{"const":"response"},"request_id":{"type":"string"},"action":{"const":"inspect.activity"},"ok":{"const":true},"activity":{"$ref":"#/$defs/activity"}},"required":["ipc_version","kind","request_id","action","ok","activity"]},
    "inspect_project_success_response":{"type":"object","additionalProperties":false,"properties":{"ipc_version":{"const":2},"kind":{"const":"response"},"request_id":{"type":"string"},"action":{"const":"inspect.project"},"ok":{"const":true},"project":{"$ref":"#/$defs/project_inspection"}},"required":["ipc_version","kind","request_id","action","ok","project"]},
    "error_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipc_version": {"const": 2},
        "kind": {"const": "response"},
        "request_id": {"type": "string"},
        "action": {"type": "string"},
        "ok": {"const": false},
        "error": {"$ref": "#/$defs/error"}
      },
      "required": ["ipc_version", "kind", "request_id", "action", "ok", "error"]
    },
    "receipt_v1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 1},
        "operation_id": {"type": "string"},
        "session_id": {"type": "string"},
        "fingerprint": {"type": "string"},
        "daemon_incarnation": {"type": "string"},
        "state": {"enum": ["starting", "running", "finalizing", "completed", "failed", "timed_out", "killed", "abandoned"]},
        "outcome": {"enum": ["", "success", "failure", "timeout", "killed", "ambiguous"]},
        "shell": {"type": "string"},
        "cwd": {"type": "string"},
        "tty": {"type": "boolean"},
        "timeout_ms": {"type": "integer"},
        "output_bytes": {"type": "integer"},
        "output_complete": {"type": "boolean"},
        "input_accepted_bytes": {"type": "integer"},
        "input_delivered_bytes": {"type": "integer"},
        "stdin_closed": {"type": "boolean"},
        "failure_reason": {"type": "string"},
        "spawn_evidence": {"type": "object"},
        "exit_evidence": {"type": "object"},
        "signal_evidence": {"type": "object"}
      },
      "required": [
        "schema_version",
        "operation_id",
        "session_id",
        "fingerprint",
        "daemon_incarnation",
        "state",
        "outcome",
        "output_bytes",
        "output_complete",
        "input_accepted_bytes",
        "input_delivered_bytes"
      ]
    },
    "receipt_v2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 2},
        "operation_id": {"type": "string", "minLength": 1},
        "session_id": {"type": "string", "minLength": 1},
        "request_fingerprint": {"type": "string", "minLength": 1},
        "execution_fingerprint": {"type": "string", "minLength": 1},
        "observation_binding_fingerprint": {"type": "string", "minLength": 1},
        "daemon_incarnation": {"type": "string", "minLength": 1},
        "execution_mode": {"enum": ["shell", "argv"]},
        "executable": {"type": "string", "minLength": 1},
        "state": {"enum": ["starting", "running", "finalizing", "completed", "failed", "timed_out", "killed", "abandoned"]},
        "outcome": {"enum": ["", "success", "failure", "timeout", "killed", "ambiguous"]},
        "shell": {"type": "string"},
        "cwd": {"type": "string"},
        "tty": {"type": "boolean"},
        "timeout_ms": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0},
        "output_complete": {"type": "boolean"},
        "input_accepted_bytes": {"type": "integer", "minimum": 0},
        "input_delivered_bytes": {"type": "integer", "minimum": 0},
        "stdin_closed": {"type": "boolean"},
        "failure_reason": {"type": "string"},
        "spawn_evidence": {"$ref": "#/$defs/spawn_evidence"},
        "exit_evidence": {"$ref": "#/$defs/exit_evidence"},
        "signal_evidence": {"$ref": "#/$defs/signal_evidence"}
      },
      "required": [
        "schema_version",
        "operation_id",
        "session_id",
        "request_fingerprint",
        "execution_fingerprint",
        "daemon_incarnation",
        "state",
        "outcome",
        "tty",
        "timeout_ms",
        "output_bytes",
        "output_complete",
        "input_accepted_bytes",
        "input_delivered_bytes",
        "stdin_closed",
        "spawn_evidence",
        "exit_evidence",
        "signal_evidence"
      ]
    },
    "signal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"requested": {"type": "string"}, "attempted": {"type": "boolean"}, "succeeded": {"type": "boolean"}},
      "required": ["attempted", "succeeded"]
    },
    "operation_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "activity_id": {"type": "string"},
        "workspace_id": {"type": "string"},
        "session_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["starting", "running", "finalizing", "terminal"]}
      },
      "required": ["operation_id", "session_id", "state"]
    },
    "child_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["pending", "running", "exited", "spawn_failed", "unknown"]},
        "outcome": {"enum": ["success", "failure", "timeout", "killed", "ambiguous"]},
        "exit_code": {"type": "integer"},
        "signal": {"type": "string"},
        "timed_out": {"type": "boolean"}
      },
      "required": ["state", "timed_out"]
    },
    "output_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_stream": {"const": "combined"},
        "preview": {"type": "string"},
        "raw_bytes": {"type": "integer", "minimum": 0},
        "returned_bytes": {"type": "integer", "minimum": 0},
        "cursor": {"type": "integer", "minimum": 0},
        "next_cursor": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "output_complete": {"type": "boolean"}
      },
      "required": ["canonical_stream", "raw_bytes", "returned_bytes", "cursor", "next_cursor", "truncated", "output_complete"]
    },
    "context_event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "workspace_id": {"type": "string"},
        "generation": {"type": "string"},
        "transition_fingerprint": {"type": "string"}
      },
      "required": ["code", "message", "transition_fingerprint"]
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "severity": {"type": "string"},
        "message": {"type": "string"},
        "workspace_id": {"type": "string"},
        "cause_fingerprint": {"type": "string"}
      },
      "required": ["code", "severity", "message", "cause_fingerprint"]
    },
    "structured_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 2},
        "operation": {"$ref": "#/$defs/operation_result"},
        "child": {"$ref": "#/$defs/child_result"},
        "output": {"$ref": "#/$defs/output_result"},
        "context_events": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/context_event"}},
        "advisories": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/advisory"}},
        "receipt": {"oneOf": [{"$ref": "#/$defs/receipt_v1"}, {"$ref": "#/$defs/receipt_v2"}]}
      },
      "required": ["schema_version", "operation", "child", "output"]
    },
    "start_poll_success_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipc_version": {"const": 2},
        "kind": {"const": "response"},
        "request_id": {"type": "string"},
        "action": {"enum": ["start", "poll"]},
        "ok": {"const": true},
        "result": {"$ref": "#/$defs/structured_result"}
      },
