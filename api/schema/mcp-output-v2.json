    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "severity": {"type": "string"},
        "message": {"type": "string"},
        "workspace_id": {"type": "string"},
        "cause_fingerprint": {"type": "string"}
      },
      "required": ["code", "severity", "message", "cause_fingerprint"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {"const": 2},
        "operation": {"$ref": "#/$defs/operation"},
        "child": {"$ref": "#/$defs/child"},
        "output": {"$ref": "#/$defs/output"},
        "context_events": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/context_event"}},
        "advisories": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/advisory"}},
        "receipt": {"oneOf":[{"$ref":"#/$defs/receipt_v1"},{"$ref":"#/$defs/receipt_v2"}]}
      },
      "required": ["schema_version", "operation", "child", "output"]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {"type": "string"},
        "activity_id": {"type": "string"},
        "workspace_id": {"type": "string"},
        "session_id": {"type": "string"},
        "state": {"type": "string"},
        "outcome": {"type": "string"},
        "output": {"type": "string"},
        "cursor": {"type": "integer"},
        "next_cursor": {"type": "integer"},
        "truncated": {"type": "boolean"},
        "accepted_input_bytes": {"type": "integer"},
        "next_input_offset": {"type": "integer"},
        "eof_queued": {"type": "boolean"},
        "kill_id": {"type": "string"},
        "signal": {"type": "string"},
        "receipt": {"oneOf":[{"$ref":"#/$defs/receipt_v1"},{"$ref":"#/$defs/receipt_v2"},{"type":"null"}]}
