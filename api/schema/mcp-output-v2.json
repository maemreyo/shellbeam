{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shellbeam.dev/schema/mcp-output-v2.json",
  "title": "local_shell output v2",
  "type": "object",
  "unevaluatedProperties": false,
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}},
      "required": ["code", "message", "retryable"]
    },
    "spawn_evidence": {"type":"object","additionalProperties":false,"properties":{"attempted":{"type":"boolean"},"succeeded":{"type":"boolean"},"error_code":{"type":"string"}},"required":["attempted","succeeded"]},
    "exit_evidence": {"type":"object","additionalProperties":false,"properties":{"reaped":{"type":"boolean"},"code":{"type":"integer"},"signal":{"type":"string"}},"required":["reaped"]},
    "signal_evidence": {"type":"object","additionalProperties":false,"properties":{"requested":{"type":"string"},"attempted":{"type":"boolean"},"succeeded":{"type":"boolean"}},"required":["attempted","succeeded"]},
    "workspace_observation": {"oneOf":[{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"freshly_sampled"},"quality":{"enum":["fresh","cached","stale"]},"diagnostic_code":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"string","pattern":"^gen_[0-9a-f]{64}$"},"observed_at":{"type":"string","format":"date-time"}},"required":["kind","quality","generation","observed_at"]},{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"freshly_sampled"},"quality":{"const":"unavailable"},"diagnostic_code":{"type":"string","minLength":1,"maxLength":128},"observed_at":{"type":"string","format":"date-time"}},"required":["kind","quality","observed_at","diagnostic_code"]},{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"cached"},"quality":{"enum":["fresh","cached","stale"]},"diagnostic_code":{"type":"string","minLength":1,"maxLength":128},"generation":{"type":"string","pattern":"^gen_[0-9a-f]{64}$"},"observed_at":{"type":"string","format":"date-time"}},"required":["kind","quality","generation","observed_at"]},{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"cached"},"quality":{"const":"unavailable"},"diagnostic_code":{"type":"string","minLength":1,"maxLength":128}},"required":["kind","quality","diagnostic_code"]},{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"unreconciled"},"diagnostic_code":{"type":"string","minLength":1,"maxLength":128},"observation_invalidated":{"type":"boolean"}},"required":["kind"]}]},
    "workspace_provenance": {"oneOf":[{"type":"object","additionalProperties":false,"properties":{"schema_version":{"const":1},"repository_id":{"type":"string","pattern":"^repo_[0-9A-HJKMNP-TV-Z]{26}$"},"workspace_id":{"type":"string","pattern":"^ws_[0-9A-HJKMNP-TV-Z]{26}$"},"pre_generation":{"type":"string","pattern":"^gen_[0-9a-f]{64}$"},"post_generation":{"type":"string","pattern":"^gen_[0-9a-f]{64}$"},"pre_quality":{"enum":["fresh","cached","stale","unavailable"]},"post_quality":{"enum":["fresh","cached","stale","unavailable"]},"pre_observed_at":{"type":"string","format":"date-time"},"post_observed_at":{"type":"string","format":"date-time"},"pre_diagnostic_code":{"type":"string","maxLength":128},"post_diagnostic_code":{"type":"string","maxLength":128},"observed_change":{"type":"boolean"}},"required":["schema_version","pre_quality","post_quality","pre_observed_at","post_observed_at","observed_change"]},{"type":"object","additionalProperties":false,"properties":{"schema_version":{"const":2},"binding":{"type":"object","additionalProperties":false,"properties":{"repository_id":{"type":"string","pattern":"^repo_[0-9A-HJKMNP-TV-Z]{26}$"},"workspace_id":{"type":"string","pattern":"^ws_[0-9A-HJKMNP-TV-Z]{26}$"}}},"pre":{"$ref":"#/$defs/workspace_observation"},"post":{"$ref":"#/$defs/workspace_observation"},"observed_change":{"type":"boolean"}},"required":["schema_version","binding","pre","post","observed_change"]}]},
    "receipt_v1": {"type":"object","additionalProperties":false,"properties":{"schema_version":{"const":1},"operation_id":{"type":"string"},"session_id":{"type":"string"},"fingerprint":{"type":"string"},"daemon_incarnation":{"type":"string"},"state":{"enum":["starting","running","finalizing","completed","failed","timed_out","killed","abandoned"]},"outcome":{"enum":["","success","failure","timeout","killed","ambiguous"]},"shell":{"type":"string"},"cwd":{"type":"string"},"tty":{"type":"boolean"},"timeout_ms":{"type":"integer"},"output_bytes":{"type":"integer"},"output_complete":{"type":"boolean"},"input_accepted_bytes":{"type":"integer"},"input_delivered_bytes":{"type":"integer"},"stdin_closed":{"type":"boolean"},"failure_reason":{"type":"string"},"workspace_provenance":{"$ref":"#/$defs/workspace_provenance"},"spawn_evidence":{"type":"object"},"exit_evidence":{"type":"object"},"signal_evidence":{"type":"object"}},"required":["schema_version","operation_id","session_id","fingerprint","daemon_incarnation","state","outcome","output_bytes","output_complete","input_accepted_bytes","input_delivered_bytes"]},
    "receipt_v2": {"type":"object","additionalProperties":false,"properties":{"schema_version":{"const":2},"operation_id":{"type":"string","minLength":1},"session_id":{"type":"string","minLength":1},"request_fingerprint":{"type":"string","minLength":1},"execution_fingerprint":{"type":"string","minLength":1},"observation_binding_fingerprint":{"type":"string","minLength":1},"daemon_incarnation":{"type":"string","minLength":1},"execution_mode":{"enum":["shell","argv"]},"executable":{"type":"string","minLength":1},"state":{"enum":["starting","running","finalizing","completed","failed","timed_out","killed","abandoned"]},"outcome":{"enum":["","success","failure","timeout","killed","ambiguous"]},"shell":{"type":"string"},"cwd":{"type":"string"},"tty":{"type":"boolean"},"timeout_ms":{"type":"integer","minimum":0},"output_bytes":{"type":"integer","minimum":0},"output_complete":{"type":"boolean"},"input_accepted_bytes":{"type":"integer","minimum":0},"input_delivered_bytes":{"type":"integer","minimum":0},"stdin_closed":{"type":"boolean"},"failure_reason":{"type":"string"},"spawn_evidence":{"$ref":"#/$defs/spawn_evidence"},"exit_evidence":{"$ref":"#/$defs/exit_evidence"},"signal_evidence":{"$ref":"#/$defs/signal_evidence"}},"required":["schema_version","operation_id","session_id","request_fingerprint","execution_fingerprint","daemon_incarnation","state","outcome","tty","timeout_ms","output_bytes","output_complete","input_accepted_bytes","input_delivered_bytes","stdin_closed","spawn_evidence","exit_evidence","signal_evidence"]},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"operation_id": {"type": "string", "minLength": 1}, "activity_id": {"type": "string"}, "workspace_id": {"type": "string"}, "session_id": {"type": "string", "minLength": 1}, "state": {"enum": ["starting", "running", "finalizing", "terminal"]}},
      "required": ["operation_id", "session_id", "state"]
