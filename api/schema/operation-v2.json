{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shellbeam.dev/schema/operation-v2.json",
  "title": "ShellBeam operation reservation v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "operation_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "request_fingerprint": {"type": "string", "minLength": 1},
    "execution_fingerprint": {"type": "string", "minLength": 1},
    "observation_binding_fingerprint": {"type": "string", "minLength": 1},
    "structured_adapter": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "execution_mode": {"enum": ["shell", "argv"]},
    "executable": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "prefixItems": [{"type": "string", "minLength": 1}], "items": {"type": "string"}},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"},
    "logical_cwd": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "cwd": {"type": "string", "minLength": 1},
    "tty": {"type": "boolean"},
    "timeout_ms": {"type": "integer", "minimum": 0},
    "shell": {"type": "string", "minLength": 1},
    "daemon_incarnation": {"type": "string", "minLength": 1},
    "control_reservation_bytes": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "minLength": 1}
  },
  "required": [
    "schema_version", "operation_id", "session_id", "request_fingerprint",
    "execution_fingerprint", "cwd", "daemon_incarnation"
  ],
  "allOf": [
    {"if": {"required": ["workspace_id"]}, "then": {"required": ["logical_cwd"]}},
    {"if": {"required": ["logical_cwd"]}, "then": {"required": ["workspace_id"]}},
    {"oneOf": [{"required": ["command", "shell"], "not": {"anyOf": [{"required": ["execution_mode"]}, {"required": ["argv"]}, {"required": ["executable"]}]}}, {"properties": {"execution_mode": {"const": "shell"}}, "required": ["execution_mode", "executable", "command", "shell"], "not": {"required": ["argv"]}}, {"properties": {"execution_mode": {"const": "argv"}}, "required": ["execution_mode", "executable", "argv"], "not": {"anyOf": [{"required": ["command"]}, {"required": ["shell"]}]}}]}
  ]
}
