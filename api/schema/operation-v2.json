{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shellbeam.dev/schema/operation-v2.json",
  "title": "ShellBeam operation reservation v2",
  "type": "object",
  "additionalProperties": false,
  "$defs": {"input_trace_binding": {"type":"object","additionalProperties":false,"properties":{"schema_version":{"const":1},"trace_id":{"type":"string","pattern":"^trace_[0-9A-HJKMNP-TV-Z]{26}$"},"mode":{"enum":["best_effort","required"]},"status":{"const":"active"},"provider":{"type":"object","additionalProperties":false,"properties":{"provider_id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},"provider_version":{"type":"integer","minimum":1},"capability_version":{"type":"integer","minimum":1}},"required":["provider_id","provider_version","capability_version"]},"platform":{"type":"string","minLength":1,"maxLength":64},"instrumentation_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},"instrumentation_effect":{"enum":["none","non_invasive","environment_affecting"]},"pre_exec_coverage_established":{"type":"boolean"},"coverage":{"type":"object","additionalProperties":false,"properties":{"filesystem_reads":{"enum":["unsupported","unknown","partial","complete_for_owned_tree"]},"filesystem_metadata_queries":{"enum":["unsupported","unknown","partial","complete_for_owned_tree"]},"directory_enumerations":{"enum":["unsupported","unknown","partial","complete_for_owned_tree"]},"filesystem_writes":{"enum":["unsupported","unknown","partial","complete_for_owned_tree"]},"executed_binaries":{"enum":["unsupported","unknown","partial","complete_for_owned_tree"]},"loaded_libraries":{"enum":["unsupported","unknown","partial","complete_for_owned_tree"]},"environment_names_observed":{"enum":["unsupported","unknown","partial","complete_for_owned_tree"]},"network_attempts":{"enum":["unsupported","unknown","partial","complete_for_owned_tree"]},"child_processes":{"enum":["unsupported","unknown","partial","complete_for_owned_tree"]}},"required":["filesystem_reads","filesystem_metadata_queries","directory_enumerations","filesystem_writes","executed_binaries","loaded_libraries","environment_names_observed","network_attempts","child_processes"]}},"required":["schema_version","trace_id","mode","status","provider","platform","instrumentation_fingerprint","instrumentation_effect","pre_exec_coverage_established","coverage"]}},
  "properties": {
    "schema_version": {"const": 2},
    "operation_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "request_fingerprint": {"type": "string", "minLength": 1},
    "execution_fingerprint": {"type": "string", "minLength": 1},
    "observation_binding_fingerprint": {"type": "string", "minLength": 1},
    "input_trace": {"$ref":"#/$defs/input_trace_binding"},
    "resource_limits": {"type":"object","additionalProperties":false,"minProperties":1,"properties":{"memory_bytes":{"type":"integer","minimum":1},"processes":{"type":"integer","minimum":1},"cpu_time_ms":{"type":"integer","minimum":1}}},
    "hermetic_boundary": {"type":"object","additionalProperties":false,"properties":{"schema_version":{"const":1},"boundary_id":{"type":"string","pattern":"^hb_[0-9A-HJKMNP-TV-Z]{26}$"},"request":{"type":"object","additionalProperties":false,"properties":{"version":{"const":1},"mode":{"const":"required"},"repo_inputs":{"type":"array","minItems":1,"maxItems":256,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1024,"allOf":[{"not":{"pattern":"^/"}},{"not":{"pattern":"\\\\"}},{"not":{"pattern":"(^|/)\\.\\.?(/|$)"}},{"not":{"pattern":"(^|/)\\.git(/|$)"}},{"oneOf":[{"pattern":"^[^/*?\\[\\]{}]+(?:/[^/*?\\[\\]{}]+)*$"},{"pattern":"^[^/*?\\[\\]{}]+(?:/[^/*?\\[\\]{}]+)*/\\*\\*$"}]}]}},"network":{"const":"off"},"environment":{"const":"fixed_allowlist"},"stdin":{"const":"closed"},"writes":{"const":"ephemeral_discard"}},"required":["version","mode","repo_inputs","network","environment","stdin","writes"]},"capture_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"capture_content_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"provider":{"type":"object","additionalProperties":false,"properties":{"provider":{"const":"bubblewrap"},"version":{"const":"0.11.2"},"binary_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"runtime_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"security_policy_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$","maxLength":256},"security_policy_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"required":["provider","version","binary_sha256","runtime_manifest_sha256"],"allOf":[{"if":{"required":["security_policy_id"]},"then":{"required":["security_policy_sha256"]}},{"if":{"required":["security_policy_sha256"]},"then":{"required":["security_policy_id"]}}]},"toolchain":{"type":"object","additionalProperties":false,"properties":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$"},"manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"required":["id","manifest_sha256"]}},"required":["schema_version","boundary_id","request","capture_manifest_sha256","capture_content_sha256","provider","toolchain"]},
    "environment_binding": {"type":"object","additionalProperties":false,"properties":{"snapshot_id":{"type":"string","pattern":"^env_[0-9a-f]{64}$"},"environment_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},"environment_fingerprint_version":{"const":1},"toolchain_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},"toolchain_fingerprint_version":{"const":1},"captured_at":{"type":"string","format":"date-time"}},"required":["snapshot_id","environment_fingerprint","environment_fingerprint_version","captured_at"],"allOf":[{"if":{"required":["toolchain_fingerprint"]},"then":{"required":["toolchain_fingerprint_version"]}},{"if":{"required":["toolchain_fingerprint_version"]},"then":{"required":["toolchain_fingerprint"]}}]},
    "structured_adapter": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "execution_mode": {"enum": ["shell", "argv"]},
    "executable": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "prefixItems": [{"type": "string", "minLength": 1}], "items": {"type": "string"}},
    "workspace_id": {"type": "string", "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"},
    "logical_cwd": {"type": "string", "minLength": 1},
    "command": {"type": "string", "minLength": 1},
    "cwd": {"type": "string", "minLength": 1},
    "tty": {"type": "boolean"},
    "timeout_ms": {"type": "integer", "minimum": 0},
    "shell": {"type": "string", "minLength": 1},
    "daemon_incarnation": {"type": "string", "minLength": 1},
    "control_reservation_bytes": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string", "minLength": 1}
