{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shellbeam.dev/schema/receipt-v3.json",
  "title": "ShellBeam typed project receipt v3",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "workspace_observation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "freshly_sampled"
            },
            "quality": {
              "enum": [
                "fresh",
                "cached",
                "stale"
              ]
            },
            "diagnostic_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "generation": {
              "type": "string",
              "pattern": "^gen_[0-9a-f]{64}$"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "quality",
            "generation",
            "observed_at"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "freshly_sampled"
            },
            "quality": {
              "const": "unavailable"
            },
            "diagnostic_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "quality",
            "observed_at",
            "diagnostic_code"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cached"
            },
            "quality": {
              "enum": [
                "fresh",
                "cached",
                "stale"
              ]
            },
            "diagnostic_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "generation": {
              "type": "string",
              "pattern": "^gen_[0-9a-f]{64}$"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "kind",
            "quality",
            "generation",
            "observed_at"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cached"
            },
            "quality": {
              "const": "unavailable"
            },
            "diagnostic_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "quality",
            "diagnostic_code"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unreconciled"
            },
            "diagnostic_code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "observation_invalidated": {
              "type": "boolean"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "workspace_provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "repository_id": {
              "type": "string",
              "pattern": "^repo_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "workspace_id": {
              "type": "string",
              "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "pre_generation": {
              "type": "string",
              "pattern": "^gen_[0-9a-f]{64}$"
            },
            "post_generation": {
              "type": "string",
              "pattern": "^gen_[0-9a-f]{64}$"
            },
            "pre_quality": {
              "enum": [
                "fresh",
                "cached",
                "stale",
                "unavailable"
              ]
            },
            "post_quality": {
              "enum": [
                "fresh",
                "cached",
                "stale",
                "unavailable"
              ]
            },
            "pre_observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "post_observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "pre_diagnostic_code": {
              "type": "string",
              "maxLength": 128
            },
            "post_diagnostic_code": {
              "type": "string",
              "maxLength": 128
            },
            "observed_change": {
              "type": "boolean"
            }
          },
          "required": [
            "schema_version",
            "pre_quality",
            "post_quality",
            "pre_observed_at",
            "post_observed_at",
            "observed_change"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 2
            },
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository_id": {
                  "type": "string",
                  "pattern": "^repo_[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "workspace_id": {
                  "type": "string",
                  "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"
                }
              }
            },
            "pre": {
              "$ref": "#/$defs/workspace_observation"
            },
            "post": {
              "$ref": "#/$defs/workspace_observation"
            },
            "observed_change": {
              "type": "boolean"
            }
          },
          "required": [
            "schema_version",
            "binding",
            "pre",
            "post",
            "observed_change"
          ]
        }
      ]
    },
    "spawn_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "succeeded": {
          "type": "boolean"
        },
        "error_code": {
          "type": "string"
        }
      },
      "required": [
        "attempted",
        "succeeded"
      ]
    },
    "exit_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reaped": {
          "type": "boolean"
        },
        "code": {
          "type": "integer"
        },
        "signal": {
          "type": "string"
        }
      },
      "required": [
        "reaped"
      ]
    },
    "signal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "string"
        },
        "attempted": {
          "type": "boolean"
        },
        "succeeded": {
          "type": "boolean"
        }
      },
      "required": [
        "attempted",
        "succeeded"
      ]
    },
    "project_parameter_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "kind": {
          "enum": [
            "string",
            "enum",
            "integer",
            "repo_path",
            "repo_package"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "source": {
          "enum": [
            "caller",
            "default"
          ]
        },
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "provider_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "kind",
        "value",
        "source"
      ]
    },
    "project_command_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_schema_version": {
          "const": 2
        },
        "command_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "parameter_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/project_parameter_binding"
          }
        },
        "resolved_argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "logical_cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "resolved_cwd": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 4096
        },
        "source_generation": {
          "type": "string",
          "pattern": "^gen_[0-9a-f]{64}$"
        },
        "path_observation_quality": {
          "enum": [
            "exact_at_bind"
          ]
        }
      },
      "required": [
        "schema_version",
        "manifest_digest",
        "manifest_schema_version",
        "command_id",
        "parameter_fingerprint",
        "parameters",
        "resolved_argv",
        "logical_cwd",
        "resolved_cwd"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": 3
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "request_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "execution_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "observation_binding_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "daemon_incarnation": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "enum": [
        "shell",
        "argv"
      ]
    },
    "executable": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "starting",
        "running",
        "finalizing",
        "completed",
        "failed",
        "timed_out",
        "killed",
        "abandoned"
      ]
    },
    "outcome": {
      "enum": [
        "",
        "success",
        "failure",
        "timeout",
        "killed",
        "ambiguous"
      ]
    },
    "shell": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "tty": {
      "type": "boolean"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "output_complete": {
      "type": "boolean"
    },
    "input_accepted_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "input_delivered_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "stdin_closed": {
      "type": "boolean"
    },
    "failure_reason": {
      "type": "string"
    },
    "workspace_provenance": {
      "$ref": "#/$defs/workspace_provenance"
    },
    "spawn_evidence": {
      "$ref": "#/$defs/spawn_evidence"
    },
    "exit_evidence": {
      "$ref": "#/$defs/exit_evidence"
    },
    "signal_evidence": {
      "$ref": "#/$defs/signal_evidence"
    },
    "project_command": {
      "$ref": "#/$defs/project_command_binding"
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "session_id",
    "request_fingerprint",
    "execution_fingerprint",
    "daemon_incarnation",
    "state",
    "outcome",
    "tty",
    "timeout_ms",
    "output_bytes",
    "output_complete",
    "input_accepted_bytes",
    "input_delivered_bytes",
    "stdin_closed",
    "spawn_evidence",
    "exit_evidence",
    "signal_evidence",
    "project_command"
  ]
}
