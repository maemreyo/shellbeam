{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shellbeam.dev/schema/mcp-input-v2.json",
  "title": "local_shell input v2",
  "type": "object",
  "unevaluatedProperties": false,
  "oneOf": [
    {
      "properties": {
        "action": {"const": "start"},
        "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
        "workspace_id": {"type": "string", "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"},
        "activity_id": {"type": "string", "minLength": 1, "maxLength": 128, "allOf": [{"not": {"pattern": "/"}}, {"not": {"pattern": "\\\\"}}]},
        "workspace_hint": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "workspace_id": {"type": "string", "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"},
            "branch": {"type": "string", "maxLength": 128},
            "git_profile": {"type": "string", "maxLength": 128}
          }
        },
        "command": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "prefixItems": [{"type": "string", "minLength": 1}], "items": {"type": "string"}},
        "intent": {"type": "object", "additionalProperties": false, "properties": {"kind": {"enum": ["inspect", "format", "edit", "test", "build", "generate", "git-push", "release", "long-running", "other"]}, "mutates_source": {"oneOf": [{"type": "boolean"}, {"type": "null"}]}, "external_effect": {"oneOf": [{"type": "boolean"}, {"type": "null"}]}}, "required": ["kind"]},
        "cwd": {"type": "string"},
        "tty": {"type": "boolean", "default": false},
        "yield_time_ms": {"type": "integer", "minimum": 0, "default": 10000},
        "timeout_ms": {"type": "integer", "minimum": 0, "default": 0},
        "max_output_bytes": {"type": "integer", "minimum": 0, "default": 20000}
      },
      "required": ["action", "operation_id"],
      "allOf": [
        {"oneOf": [
        {"required": ["workspace_id"], "not": {"properties": {"cwd": {"pattern": "^/"}}, "required": ["cwd"]}},
        {"required": ["cwd"], "properties": {"cwd": {"pattern": "^/"}}, "not": {"required": ["workspace_id"]}}
        ]},
        {"oneOf": [
          {"required": ["command"], "not": {"required": ["argv"]}},
          {"required": ["argv"], "not": {"required": ["command"]}}
        ]}
      ]
    },
    {
      "properties": {
        "action": {"const": "poll"},
        "session_id": {"type": "string", "minLength": 1},
        "cursor": {"type": "integer", "minimum": 0, "default": 0},
        "yield_time_ms": {"type": "integer", "minimum": 0, "default": 0},
        "max_output_bytes": {"type": "integer", "minimum": 0, "default": 20000}
      },
      "required": ["action", "session_id"]
    },
    {
      "properties": {
        "action": {"const": "write"},
        "session_id": {"type": "string", "minLength": 1},
        "input_offset": {"type": "integer", "minimum": 0},
        "chars": {"type": "string", "minLength": 1},
        "eof": {"const": true}
      },
      "required": ["action", "session_id", "input_offset"],
      "oneOf": [{"required": ["chars"], "not": {"required": ["eof"]}}, {"required": ["eof"], "not": {"required": ["chars"]}}]
    },
    {
      "properties": {
        "action": {"const": "kill"},
        "session_id": {"type": "string", "minLength": 1},
        "kill_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
        "signal": {"enum": ["INT", "TERM", "KILL"], "default": "TERM"}
      },
      "required": ["action", "session_id", "kill_id"]
    },
    {"properties": {"action": {"const": "inspect.server"}}, "required": ["action"]},
    {"properties": {"action": {"const": "inspect.workspace"}, "workspace_id": {"type": "string", "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"}}, "required": ["action", "workspace_id"]},
    {"properties": {"action": {"const": "inspect.activity"}, "activity_id": {"type": "string", "minLength": 1, "maxLength": 128}}, "required": ["action", "activity_id"]},
    {"properties": {"action": {"const": "inspect.project"}, "workspace_id": {"type": "string", "pattern": "^ws_[0-9A-HJKMNP-TV-Z]{26}$"}}, "required": ["action", "workspace_id"]},
    {"properties":{"action":{"const":"inspect.events"},"target":{"oneOf":[{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"operation"},"operation_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}},"required":["kind","operation_id"]},{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"session"},"session_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}},"required":["kind","session_id"]},{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"activity"},"activity_id":{"type":"string","minLength":1,"maxLength":128,"allOf":[{"not":{"pattern":"/"}},{"not":{"pattern":"\\\\"}}]}},"required":["kind","activity_id"]},{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"workspace"},"workspace_id":{"type":"string","pattern":"^ws_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["kind","workspace_id"]},{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"repository"},"repository_id":{"type":"string","pattern":"^repo_[0-9A-HJKMNP-TV-Z]{26}$"}},"required":["kind","repository_id"]}]},"after_event_cursor":{"type":"string","minLength":12,"maxLength":2048,"pattern":"^evtcur_v1_[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"},"max_events":{"type":"integer","minimum":1,"maximum":256}},"required":["action","target","max_events"]}
  ]
}
